rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Check if the user document exists and has the isAdmin flag set to true.
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Rules for collections
    match /users/{userId} {
      // Allow users to create their own document.
      // Allow users to update/delete their own document OR if the request is from an admin.
      allow read, create: if request.auth != null;
      allow update, delete: if isOwner(userId) || isAdmin();
    }
    
    match /games/{gameId} {
      // Any authenticated user can read games.
      // Only admins can create, update, or delete games.
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /banners/{bannerId} {
       // Any authenticated user can read banners.
      // Only admins can create, update, or delete banners.
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /jodiCharts/{chartId} {
      // Any authenticated user can read charts.
      // Only admins can write to charts.
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /panelCharts/{chartId} {
      // Any authenticated user can read charts.
      // Only admins can write to charts.
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /bids/{bidId} {
      // Users can create and read their own bids.
      // Admins can read/write all bids.
      allow create: if isOwner(request.resource.data.userId);
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin();
    }
    
    match /deposits/{depositId} {
      // Users can create and read their own deposit requests.
      // Admins can read/write all requests.
       allow create: if isOwner(request.resource.data.userId);
       allow read: if isOwner(resource.data.userId) || isAdmin();
       allow write: if isAdmin();
    }
    
    match /withdrawals/{withdrawalId} {
       // Users can create and read their own withdrawal requests.
       // Admins can read/write all requests.
       allow create: if isOwner(request.resource.data.userId);
       allow read: if isOwner(resource.data.userId) || isAdmin();
       allow write: if isAdmin();
    }
    
    match /settings/{settingId} {
        // Any authenticated user can read settings.
        // Only admins can change settings.
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }
    
    match /app-stats/{statId} {
      // Allow any authenticated user to read stats for the dashboard.
      // Only admins can update stats.
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
