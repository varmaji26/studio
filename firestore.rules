rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check for admin status
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Users can manage their own document, admins can manage any
    match /users/{userId} {
      allow read, update, delete: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
      // Admins can list all users
      allow list: if isAdmin();
    }

    // Admins can manage these collections fully. Logged-in users can read.
    match /{path=**}/games/{gameId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }
     match /{path=**}/banners/{bannerId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }
     match /{path=**}/settings/{settingId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }
     match /{path=**}/jodiCharts/{chartId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }
     match /{path=**}/panelCharts/{chartId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }


    // Bids, deposits, and withdrawals have user-specific and admin rules
    match /bids/{bidId} {
        allow read: if resource.data.userId == request.auth.uid || isAdmin();
        allow create: if request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin();
        // Admins can list all bids
        allow list: if isAdmin();
    }

     match /deposits/{depositId} {
        allow read: if resource.data.userId == request.auth.uid || isAdmin();
        allow create: if request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin();
        // Admins can list all deposits
        allow list: if isAdmin();
    }

     match /withdrawals/{withdrawalId} {
        allow read: if resource.data.userId == request.auth.uid || isAdmin();
        allow create: if request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin();
        // Admins can list all withdrawals
        allow list: if isAdmin();
    }
    
    // Stats are readable by logged-in users, writable by admins
    match /app-stats/{statId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }
  }
}
