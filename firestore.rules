
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access for authenticated users, but restrict writes.
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // Default deny writes
    }
    
    // Allow users to create and manage their own documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow users to manage their own bids
    match /bids/{bidId} {
      allow read, write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Allow users to manage their own deposits/withdrawals
    match /deposits/{depositId} {
        allow read, write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /withdrawals/{withdrawalId} {
        allow read, write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Admins can manage specific collections
    // This assumes an 'isAdmin' flag on the user's custom claims or Firestore document
    // For simplicity here, we can keep it more open if admin logic is in backend.
    // For now, let's keep other rules simple. If admin features fail, we will adjust.
  }
}
