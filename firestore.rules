
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Users can manage their own data. Admins can manage any user's data.
    // The user document can be written to if the user is the owner OR is an admin.
    // This allows the ensureAdminUser function to set the isAdmin flag upon first login.
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId || isAdmin();
    }

    // Logged-in users can read games, banners, and settings. Only admins can modify them.
    match /games/{gameId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /banners/{bannerId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /jodiCharts/{chartId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }
     match /panelCharts/{chartId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }

    // Users can create and read their own bids/transactions. Admins can read all.
    match /bids/{bidId} {
        allow read: if request.resource.data.userId == request.auth.uid || isAdmin();
        allow create: if request.resource.data.userId == request.auth.uid;
        allow update: if isAdmin(); // Only admin can update bid status
    }
     match /deposits/{depositId} {
        allow read: if request.resource.data.userId == request.auth.uid || isAdmin();
        allow create: if request.resource.data.userId == request.auth.uid;
        allow update: if isAdmin();
    }
     match /withdrawals/{withdrawalId} {
        allow read: if request.resource.data.userId == request.auth.uid || isAdmin();
        allow create: if request.resource.data.userId == request.auth.uid;
        allow update: if isAdmin();
    }

    // App stats can only be read and updated by admins.
    match /app-stats/{statId} {
        allow read, write: if isAdmin();
    }
  }
}
