rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an admin.
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // USERS
    match /users/{userId} {
      // Admins can manage any user. Users can read/update their own data.
      allow read, update, delete: if request.auth.uid == userId || isAdmin();
      // Allow user creation for anyone who is authenticated.
      allow create: if request.auth != null;
    }
    
    // APP-STATS
    // Any authenticated user can read stats, but only admins can write them.
    match /app-stats/{docId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }
    
    // BIDS
    match /bids/{bidId} {
      // Admins can do anything. Users can create their own bids and read their own bids.
      allow read, list, update, delete: if isAdmin();
      allow create: if request.auth.uid == request.resource.data.userId;
      allow read: if request.auth.uid == resource.data.userId;
    }

    // DEPOSITS
    match /deposits/{depositId} {
      // Admins can do anything. Users can create their own deposits and read their own deposits.
      allow read, list, update, delete: if isAdmin();
      allow create: if request.auth.uid == request.resource.data.userId;
      allow read: if request.auth.uid == resource.data.userId;
    }
    
    // WITHDRAWALS
    match /withdrawals/{withdrawalId} {
       // Admins can do anything. Users can create their own withdrawals and read their own withdrawals.
      allow read, list, update, delete: if isAdmin();
      allow create: if request.auth.uid == request.resource.data.userId;
      allow read: if request.auth.uid == resource.data.userId;
    }
    
    // GAMES, BANNERS, JODI/PANEL CHARTS, SETTINGS
    // Any authenticated user can read these collections, but only admins can modify them.
    match /{collection}/{docId} 
        where collection in ['games', 'banners', 'jodiCharts', 'panelCharts', 'settings'] {
      allow read, list: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
