rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Files can be read by anyone.
    // This allows banners and other images to be displayed in your app.
    match /{allPaths=**} {
      allow read;
    }

    // Files can only be written by authenticated users.
    // This prevents unauthorized users from uploading files.
    match /{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}
