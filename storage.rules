rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow read and write access to all users.
      // WARNING: This is insecure. It's recommended to restrict access.
      // For example, to only allow authenticated users:
      // allow read, write: if request.auth != null;
      allow read, write;
    }
  }
}
